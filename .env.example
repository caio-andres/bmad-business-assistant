# Copie para .env e preencha. Nunca versione o .env.
# Todas as variáveis são opcionais: sem nada, o app sobe em modo demonstração com SQLite.

# --- Aplicação ---
APP_NAME=Alicerce
APP_ADDR=:8080
APP_BASE_URL=http://localhost:8080
APP_ENV=development
APP_TIMEZONE=America/Sao_Paulo
DATA_DIR=./data

# --- Banco (vazio = SQLite em DATA_DIR/alicerce.db; Postgres: postgres://...) ---
DATABASE_URL=

# --- Autenticação: local | oidc | dev ---
AUTH_MODE=local
SESSION_SECRET=
SIGNUP_ALLOWED_DOMAINS=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# --- LLM (API compatível com OpenAI; vazio = modo demonstração) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ROUTER_MODEL=
LLM_SUBAGENT_MODEL=
LLM_STREAM=true
LLM_STREAM_USAGE=true
LLM_EXTRA_HEADERS=
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_CONTEXT_BUDGET_TOKENS=60000

# --- Limites ---
RATE_LIMIT_PER_MINUTE=12
DAILY_TOKEN_QUOTA=2000000
MAX_TOOL_ITERATIONS=40
SUBAGENTS_ENABLED=true

# --- Runtime BMad ---
BMAD_DIR=
BMAD_ALLOWED_SKILLS=
PYTHON_BIN=auto

# --- Proteção de dados: mask | block | off ---
PII_POLICY=mask
RETENTION_DAYS=180

# --- Pesquisa web: disabled | searxng ---
WEB_SEARCH=disabled
SEARXNG_URL=

# --- Workspace central: local | github ---
PUBLISHER=local
WORKSPACE_LOCAL_DIR=./data/workspace-repo
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WORKSPACE_REPO=
GITHUB_API_URL=https://api.github.com

# --- Contexto de produto: local | github ---
REPO_SOURCE=local
REPO_LOCAL_DIR=./demo/repos
REPO_ORG=acme
REPO_SUMMARY_MAX_AGE_DAYS=7

# --- Roteador: rules | llm | chain | jev ---
ROUTER=chain
ROUTER_CONFIDENCE_THRESHOLD=0.7
JEV_API_KEY=
